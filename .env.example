# mock = no key needed; openai_compatible = Groq, Together, or any OpenAI-compatible host (Llama 4);
# anthropic = Claude via the Anthropic API (set ANTHROPIC_API_KEY below)
LLM_PROVIDER=mock
# Meta Model API (dev.meta.ai), OpenAI-compatible. Muse Spark handles text and images, so it covers every job.
# (Meta retired the old Llama API at api.llama.com in July 2026.) List models with:
#   curl -H "Authorization: Bearer $LLM_API_KEY" https://api.meta.ai/v1/models
LLM_BASE_URL=https://api.meta.ai/v1
LLM_API_KEY=
LLM_MODEL_SMART=muse-spark-1.2
LLM_MODEL_FAST=muse-spark-1.2
LLM_MODEL_VISION=muse-spark-1.2
# Muse Spark reasons before answering; at its default effort a call takes ~5-7 s, longer than the job limits.
# Huddle sends "minimal" automatically for api.meta.ai (~1-3 s). Set to override, or empty to send nothing.
# LLM_REASONING_EFFORT=minimal
# 1.2, not 1.3: Meta answered 65% of muse-spark-1.3 requests with a bogus 404 "model not found" (2026-09-26).
# On any "model not found" Huddle retries once with this model:
# LLM_MODEL_BACKUP=muse-spark-1.2
# Llama 4 on Groq instead: LLM_BASE_URL=https://api.groq.com/openai/v1 with
#   meta-llama/llama-4-maverick-17b-128e-instruct and meta-llama/llama-4-scout-17b-16e-instruct
# On Together: https://api.together.xyz/v1 with
#   meta-llama/Llama-4-Maverick-17B-128E-Instruct-FP8 and meta-llama/Llama-4-Scout-17B-16E-Instruct
LLM_CACHE=on
LLM_MAX_CONCURRENCY=4
ALLOW_UNVERIFIED_FACTS=false
PORT=8787
# Optional: force the LAN host used in QR codes, e.g. 192.168.1.23
PUBLIC_HOST=

# Voice. With ELEVENLABS_API_KEY set, Huddle uses ElevenLabs' realistic server-rendered voice (the key stays
# on the server; the TV falls back to browser speech if a line fails). TTS_PROVIDER=browser forces the built-in voice.
TTS_PROVIDER=
ELEVENLABS_API_KEY=
# Any voice id from your ElevenLabs voice library (default: Rachel)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_flash_v2_5

# Claude (LLM_PROVIDER=anthropic). Defaults: claude-opus-5 for every job, effort low (these jobs are
# short JSON with 2.5-8 s limits). Override per role if you want, e.g. ANTHROPIC_MODEL_FAST=claude-haiku-4-5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_SMART=
ANTHROPIC_MODEL_FAST=
ANTHROPIC_EFFORT=low
