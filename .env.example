# mock = no key needed; openai_compatible = Groq, Together, or any OpenAI-compatible host (Llama 4);
# anthropic = Claude via the Anthropic API (set ANTHROPIC_API_KEY below)
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Llama 4 on Groq. On Together use:
#   meta-llama/Llama-4-Maverick-17B-128E-Instruct-FP8 and meta-llama/Llama-4-Scout-17B-16E-Instruct
LLM_MODEL_SMART=meta-llama/llama-4-maverick-17b-128e-instruct
LLM_MODEL_FAST=meta-llama/llama-4-scout-17b-16e-instruct
LLM_MODEL_VISION=meta-llama/llama-4-scout-17b-16e-instruct
LLM_CACHE=on
LLM_MAX_CONCURRENCY=4
ALLOW_UNVERIFIED_FACTS=false
PORT=8787
# Optional: force the LAN host used in QR codes, e.g. 192.168.1.23
PUBLIC_HOST=

# Voice. browser = the TV's built-in speech (no key). elevenlabs = realistic server-rendered voice;
# the key stays on the server and the TV falls back to browser speech if a line fails.
TTS_PROVIDER=browser
ELEVENLABS_API_KEY=
# Any voice id from your ElevenLabs voice library (default: Rachel)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_flash_v2_5

# Claude (LLM_PROVIDER=anthropic). Defaults: claude-opus-5 for every job, effort low (these jobs are
# short JSON with 2.5-8 s limits). Override per role if you want, e.g. ANTHROPIC_MODEL_FAST=claude-haiku-4-5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_SMART=
ANTHROPIC_MODEL_FAST=
ANTHROPIC_EFFORT=low
