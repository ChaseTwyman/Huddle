{
  "name": "huddle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A game-night co-host that turns the non-fans in your family into fellow fans.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"tsx watch --clear-screen=false server/index.ts\" \"vite --host\"",
    "dev:https": "cross-env DEV_HTTPS=1 npm run dev",
    "build": "vite build",
    "start": "npm run build && cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fetch-game": "tsx scripts/fetch-game.ts",
    "simulate": "tsx scripts/simulate.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.4",
    "express": "^4.22.3",
    "nanoid": "^5.1.16",
    "openai": "^4.104.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
